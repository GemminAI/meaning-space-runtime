{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sensos:contracts/msr/calibration/0.8.0",
  "title": "IC-02 msr.calibration (payload)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exponent",
    "space_id",
    "model_build_id",
    "method",
    "null_set",
    "between_alignment",
    "values",
    "sample_config"
  ],
  "properties": {
    "exponent": {
      "type": "integer",
      "description": "values の距離の欄（noise_floor_lower・noise_floor_upper・background_mean・epsilon・delta）の量子化の指数。刻みは 2^exponent。値の範囲はスキーマも Gate も検証しない（有無と整数であることだけ）。読む側は宣言された exponent で解釈し、-30 を前提にしない"
    },
    "space_id": {
      "type": "string",
      "minLength": 1
    },
    "model_build_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "quantiles"
      ],
      "properties": {
        "name": {
          "const": "msr-geometry-calibration"
        },
        "version": {
          "type": "string"
        },
        "quantiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "epsilon",
            "delta",
            "floor"
          ],
          "properties": {
            "epsilon": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1073741824,
              "x-sensos-quantization": {
                "quantum": {
                  "base": 2,
                  "exponent": -30
                },
                "rounding": "ties-to-even",
                "tolerance_quanta": 0
              },
              "x-sensos-unit": "probability"
            },
            "delta": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1073741824,
              "x-sensos-quantization": {
                "quantum": {
                  "base": 2,
                  "exponent": -30
                },
                "rounding": "ties-to-even",
                "tolerance_quanta": 0
              },
              "x-sensos-unit": "probability"
            },
            "floor": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1073741824,
                  "x-sensos-quantization": {
                    "quantum": {
                      "base": 2,
                      "exponent": -30
                    },
                    "rounding": "ties-to-even",
                    "tolerance_quanta": 0
                  },
                  "x-sensos-unit": "probability"
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1073741824,
                  "x-sensos-quantization": {
                    "quantum": {
                      "base": 2,
                      "exponent": -30
                    },
                    "rounding": "ties-to-even",
                    "tolerance_quanta": 0
                  },
                  "x-sensos-unit": "probability"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "x-sensos-ordered": true,
              "description": "分位点の水準（確率）[下, 上]。下 < 上 は S19 で検査"
            }
          },
          "description": "分位点の水準（0〜1 の確率）。確率の格子は 2^-30 で固定（exponent の対象外）。values の閾値（距離、上限なし）とは別の概念"
        }
      }
    },
    "null_set": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^art:[0-9a-f]{64}$"
      },
      "x-sensos-ordered": false,
      "uniqueItems": true,
      "x-sensos-sort-key": [
        "$self"
      ]
    },
    "between_alignment": {
      "enum": [
        "equal_only",
        "x-common_prefix"
      ],
      "description": "x-common_prefix のときは封筒の extensions に理由と承認者（S17）"
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noise_floor_lower",
        "noise_floor_upper",
        "background_mean",
        "epsilon",
        "delta",
        "w_min",
        "codebook_ref"
      ],
      "properties": {
        "noise_floor_lower": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-sensos-quantization": {
            "quantum": {
              "base": 2,
              "exponent_from": "/exponent"
            },
            "rounding": "ties-to-even",
            "tolerance_quanta": 1
          },
          "x-sensos-unit": "distance"
        },
        "noise_floor_upper": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-sensos-quantization": {
            "quantum": {
              "base": 2,
              "exponent_from": "/exponent"
            },
            "rounding": "ties-to-even",
            "tolerance_quanta": 1
          },
          "x-sensos-unit": "distance"
        },
        "background_mean": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-sensos-quantization": {
            "quantum": {
              "base": 2,
              "exponent_from": "/exponent"
            },
            "rounding": "ties-to-even",
            "tolerance_quanta": 1
          },
          "x-sensos-unit": "distance"
        },
        "epsilon": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-sensos-quantization": {
            "quantum": {
              "base": 2,
              "exponent_from": "/exponent"
            },
            "rounding": "ties-to-even",
            "tolerance_quanta": 1
          },
          "x-sensos-unit": "distance"
        },
        "delta": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-sensos-quantization": {
            "quantum": {
              "base": 2,
              "exponent_from": "/exponent"
            },
            "rounding": "ties-to-even",
            "tolerance_quanta": 1
          },
          "x-sensos-unit": "distance"
        },
        "w_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "0 は異なる時刻のすべての組を数える"
        },
        "codebook_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "content_id"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^art:[0-9a-f]{64}$"
                },
                "content_id": {
                  "type": "string",
                  "pattern": "^cnt:[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      },
      "description": "帰無の分布から得た閾値（距離の単位、上限なし）。noise_floor_lower <= noise_floor_upper は S19 で検査"
    },
    "sample_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trajectories",
        "points",
        "dims"
      ],
      "properties": {
        "trajectories": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "dims": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
