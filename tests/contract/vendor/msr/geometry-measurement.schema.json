          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right"
          ],
          "properties": {
            "left": {
              "$ref": "#/$defs/inputRef"
            },
            "right": {
              "$ref": "#/$defs/inputRef"
            }
          }
        },
        "calibration": {
          "$ref": "#/$defs/calibrationRef"
        },
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "points_used"
          ],
          "properties": {
            "mode": {
              "enum": [
                "equal_only",
                "x-common_prefix"
              ]
            },
            "points_used": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "distance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "value"
          ],
          "properties": {
            "definition": {
              "const": "mean_step_l2"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "x-sensos-quantization": {
                "quantum": {
                  "base": 2,
                  "exponent": -30
                },
                "rounding": "ties-to-even",
                "tolerance_quanta": 1
              },
              "x-sensos-unit": "distance"
            }
          }
        },
        "verdict": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "$ref": "#/$defs/shiftState"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "calibration": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "verdict": {
                "properties": {
                  "state": {
                    "const": "UNCALIBRATED"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "inputScope": {
      "description": "single の入力の範囲（0.9.0）。full＝全長の軌跡をそのまま計測（親の役割 trajectory は窓でない軌跡の成果物）。window＝窓の成果物（msr.trajectory-window）を計測（親の役割 trajectory がその窓）。今回の実装は先頭 128 行の固定窓だけ：start と length は定数",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "full"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rule",
            "start",
            "length",
            "source_trajectory_id",
            "content_sha256"
          ],
          "properties": {
            "kind": {
              "const": "window"
            },
            "rule": {
              "const": "prefix_rows"
            },
            "start": {
              "const": 0
            },
            "length": {
              "const": 128
            },
            "source_trajectory_id": {
              "$ref": "#/$defs/sha256hex"
            },
            "content_sha256": {
              "$ref": "#/$defs/sha256hex"
            }
          }
        }
      ]
    }
  }
}
