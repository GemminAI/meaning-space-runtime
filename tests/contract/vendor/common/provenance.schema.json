{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sensos:contracts/common/provenance/0.6.2",
  "title": "IC-00 provenance (producer, parents, policy_refs, calibration_ref, rule_refs)",
  "type": "object",
  "required": ["producer", "parents", "policy_refs", "calibration_ref", "rule_refs"],
  "properties": {
    "producer": { "$ref": "#/$defs/producer" },
    "parents": {
      "type": "array",
      "x-sensos-ordered": false,
      "x-sensos-sort-key": ["/role"],
      "items": { "$ref": "#/$defs/parentRole" }
    },
    "policy_refs": {
      "type": "array",
      "x-sensos-ordered": false,
      "x-sensos-sort-key": ["/name", "/sha256"],
      "items": { "$ref": "#/$defs/policyRef" }
    },
    "calibration_ref": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/calibrationRef" }]
    },
    "rule_refs": {
      "type": "array",
      "x-sensos-ordered": false,
      "x-sensos-sort-key": ["/name", "/version", "/sha256"],
      "items": { "$ref": "#/$defs/ruleRef" }
    }
  },
  "$defs": {
    "sha256hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactId": { "type": "string", "pattern": "^art:[0-9a-f]{64}$" },
    "contentId": { "type": "string", "pattern": "^cnt:[0-9a-f]{64}$" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "build"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 }
      }
    },
    "parentRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ordered", "artifact_ids"],
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "ordered": { "type": "boolean" },
        "artifact_ids": {
          "description": "Order is significant iff the sibling `ordered` is true; when false the ids are sorted by UTF-8 byte order without duplicates (S16, checked by the reference implementation). The static annotation is therefore `true` (the conservative reading).",
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "x-sensos-ordered": true,
          "items": { "$ref": "#/$defs/artifactId" }
        }
      }
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256hex" }
      }
    },
    "ruleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256hex" }
      }
    },
    "calibrationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_id"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "content_id": { "$ref": "#/$defs/contentId" }
      }
    }
  }
}
