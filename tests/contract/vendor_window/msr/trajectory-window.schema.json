{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sensos:contracts/msr/trajectory-window/0.10.0",
  "title": "IC-02 msr.trajectory-window (payload) 0.10.0 — 軌跡の連続した行の窓（位置 start と長さ length を持つ。D-132）",
  "description": "元の軌跡（親の役割 source_trajectory）の連続した length 行（start 行目から）を、別の成果物として持つ。rule は prefix_rows（start は 0。0.9.0 の先頭窓の一般化した長さ）か rows（start >= 0、length >= 1）。窓の位置の候補（先頭・中ほど・末尾など）はここでは狭めない。start + length <= origin.length、points と token_index の行数が length であること、token_index の範囲は Gate が確かめる（スキーマは表せない）。窓の中身の sha256 は points の Blob のバイト列の sha256。0.9.0 の窓（先頭 128 行の固定）は archive/0.9.0 のスキーマで読む。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "window",
    "origin",
    "source",
    "layer",
    "dimension",
    "model_build_id",
    "policy",
    "points",
    "token_index"
  ],
  "properties": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "start",
        "length",
        "content_sha256"
      ],
      "properties": {
        "rule": {
          "enum": [
            "prefix_rows",
            "rows"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256hex"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rule": {
                "const": "prefix_rows"
              }
            }
          },
          "then": {
            "properties": {
              "start": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trajectory_id",
        "position",
        "length"
      ],
      "description": "元の軌跡。trajectory_id は元の軌跡の行のバイト列の sha256（RAW の識別子）、position は取得位置、length は元の全長（窓の end = start + length 以上。Gate が確かめる）",
      "properties": {
        "trajectory_id": {
          "$ref": "#/$defs/sha256hex"
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "source": {
      "enum": [
        "T-tok",
        "T-hid"
      ]
    },
    "layer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "model_build_id": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "description": "窓の作り方。name は窓の作り方を表す名前（形式は契約で固定しない。例：first-128-rows/1、rows-86+128/1）、sha256 は name の UTF-8 の sha256（Gate が確かめる）",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256hex"
        }
      }
    },
    "points": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "media_type",
        "dtype",
        "shape",
        "byte_order",
        "order",
        "unit"
      ],
      "description": "窓の length 行（binary32、リトルエンディアン、行優先、詰め物なし、量子化なし。NaN・±Inf は拒否）。shape[0] が length と一致することは Gate が確かめる（スキーマは表せない）",
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^blob:sha256:[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256hex"
        },
        "media_type": {
          "const": "application/vnd.sensos.ndarray-raw"
        },
        "dtype": {
          "const": "float32"
        },
        "shape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "x-sensos-ordered": true,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ],
          "items": false
        },
        "byte_order": {
          "const": "little"
        },
        "order": {
          "const": "C"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "token_index": {
      "allOf": [
        {
          "$ref": "sensos:contracts/common/blob/0.7.0#/$defs/intBlob"
        },
        {
          "properties": {
            "shape": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "x-sensos-ordered": true,
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              ],
              "items": false
            },
            "quantization": {
              "type": "null"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "T-hid"
          }
        }
      },
      "then": {
        "properties": {
          "layer": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "T-tok"
          }
        }
      },
      "then": {
        "properties": {
          "layer": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
